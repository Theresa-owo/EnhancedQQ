{
  "manifest_version": 4,
  "type": "extension",
  "name": "EnhancedQQ",
  "slug": "enhancedqq",
  "description": "QQ 增强、防撤回、Emoji 回应、群管理、Telegram 气泡、TTS 与更新屏蔽。",
  "version": "0.9.6",
  "icon": "./assets/icon.svg",
  "thumb": "./assets/icon.svg",
  "authors": [{ "name": "Theresa-owo", "link": "https://github.com/Theresa-owo" }],
  "repository": { "repo": "Theresa-owo/EnhancedQQ", "branch": "main" },
  "platform": ["win32"],
  "injects": {
    "main": "./src/main.cjs",
    "preload": "./src/preload.js",
    "renderer": "./src/renderer/index.js"
  }
}
